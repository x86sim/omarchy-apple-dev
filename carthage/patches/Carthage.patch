diff --git a/Source/CarthageKit/LinuxCompat.swift b/Source/CarthageKit/LinuxCompat.swift
new file mode 100644
index 0000000..1f280dd
--- /dev/null
+++ b/Source/CarthageKit/LinuxCompat.swift
@@ -0,0 +1,36 @@
+// Linux stand-ins for the macOS APIs Carthage uses (Launch Services type identifiers, CFNetwork proxy keys)
+import Foundation
+
+#if !canImport(Darwin)
+typealias CFString = String
+
+let kUTTypeFramework = "com.apple.framework"
+let kCFNetworkProxiesHTTPEnable = "HTTPEnable"
+let kCFNetworkProxiesHTTPProxy = "HTTPProxy"
+let kCFNetworkProxiesHTTPPort = "HTTPPort"
+let kCFNetworkProxiesHTTPSEnable = "HTTPSEnable"
+let kCFNetworkProxiesHTTPSProxy = "HTTPSProxy"
+let kCFNetworkProxiesHTTPSPort = "HTTPSPort"
+
+private let linuxTypesByExtension: [String: String] = [
+	"framework": "com.apple.framework",
+	"xcframework": "com.apple.xcframework",
+	"xcodeproj": "com.apple.xcode.project",
+	"xcworkspace": "com.apple.dt.document.workspace",
+	"dsym": "com.apple.xcode.dsym",
+	"bcsymbolmap": "com.apple.xcode.bcsymbolmap",
+	"zip": "public.zip-archive",
+	"app": "com.apple.application-bundle",
+	"bundle": "com.apple.bundle",
+]
+
+/// The type identifier macOS gives the item at URL (by its extension), if it is one Carthage asks about
+func linuxTypeIdentifier(_ url: URL) -> String? {
+	return linuxTypesByExtension[url.pathExtension.lowercased()]
+}
+
+/// UTTypeConformsTo for the identifiers above (no type hierarchy beyond equality and public.item)
+func UTTypeConformsTo(_ type: CFString, _ conformsTo: CFString) -> Bool {
+	return type == conformsTo || conformsTo == "public.item" || (conformsTo == "com.apple.bundle" && type.hasPrefix("com.apple.") && type != "public.zip-archive")
+}
+#endif
diff --git a/Source/CarthageKit/LinuxSHA256.swift b/Source/CarthageKit/LinuxSHA256.swift
new file mode 100644
index 0000000..bf37c6f
--- /dev/null
+++ b/Source/CarthageKit/LinuxSHA256.swift
@@ -0,0 +1,41 @@
+// SHA-256 for Linux, where CommonCrypto is missing (the binary-download cache file names)
+func linuxSHA256(_ message: [UInt8]) -> [UInt8] {
+	let k: [UInt32] = [
+		0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+		0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+		0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+		0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+		0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+		0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+		0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+		0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+	]
+	var h: [UInt32] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
+	var m = message
+	let bits = UInt64(message.count) * 8
+	m.append(0x80)
+	while m.count % 64 != 56 { m.append(0) }
+	for i in (0..<8).reversed() { m.append(UInt8((bits >> (UInt64(i) * 8)) & 0xff)) }
+	func rotr(_ x: UInt32, _ n: UInt32) -> UInt32 { return (x >> n) | (x << (32 - n)) }
+	for chunk in stride(from: 0, to: m.count, by: 64) {
+		var w = [UInt32](repeating: 0, count: 64)
+		for i in 0..<16 {
+			let b = chunk + i * 4
+			w[i] = UInt32(m[b]) << 24 | UInt32(m[b + 1]) << 16 | UInt32(m[b + 2]) << 8 | UInt32(m[b + 3])
+		}
+		for i in 16..<64 {
+			let s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
+			let s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
+			w[i] = w[i - 16] &+ s0 &+ w[i - 7] &+ s1
+		}
+		var a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7]
+		for i in 0..<64 {
+			let t1 = hh &+ (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) &+ ((e & f) ^ (~e & g)) &+ k[i] &+ w[i]
+			let t2 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) &+ ((a & b) ^ (a & c) ^ (b & c))
+			hh = g; g = f; f = e; e = d &+ t1; d = c; c = b; b = a; a = t1 &+ t2
+		}
+		h[0] = h[0] &+ a; h[1] = h[1] &+ b; h[2] = h[2] &+ c; h[3] = h[3] &+ d
+		h[4] = h[4] &+ e; h[5] = h[5] &+ f; h[6] = h[6] &+ g; h[7] = h[7] &+ hh
+	}
+	return h.flatMap { v in (0..<4).map { UInt8((v >> (24 - UInt32($0) * 8)) & 0xff) } }
+}
