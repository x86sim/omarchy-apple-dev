#!/usr/bin/env python3
"""build-project: builds any app project this repo knows, on Linux, with every step its kind needs.

    tools/build-project DIR [--kind K] [--platform ios|tvos|watchos|xros] [--simulator | --device] [--release]
                        [--log FILE]
    tools/build-project --detect DIR       the project's kind, or nothing (exit 1)
    tools/build-project --describe DIR...  one JSON line per DIR: dir, kind, name, bundle_id, app (the last build), or
                                           dir and error

The kind is detected (tools/buildproject/detect.py has the rules and their order); --kind overrides it. The steps:
  xtool            ship.sh --simulator (kmp/build-app.sh for a Kotlin Multiplatform app)
  dotnet, rust     dotnet/build.sh, rust/build.py
  xcodeproj        linux-bin/xcodebuild (Swift Build: swiftbuild/install.sh)
  carthage, tuist, xcodegen
                   carthage bootstrap, tuist generate / xcodegen generate, then the Xcode build
  expo, reactnative
                   npm/yarn/pnpm/bun install, expo prebuild, pod install, tools/xcbuild.py
  capacitor, cordova, nativescript, godot, unity
                   the shell's own CLI writes the Xcode project (shells/), then the Xcode build

Progress goes to stdout (each step's "== " heading and its output); on success the last line is `app: <path>`. On
failure the exit status is 1 and the last line, on stderr, is `error: <one line>`.

--device makes an unsigned device build (Xcode-built kinds, React Native / Expo); Godot apps are always device builds
(its iOS template's simulator library is x86_64 only). OAD_SETUP_HINT="<command> {}" words the "not installed" errors
with a front end's own setup command instead of the install script's path.
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from buildproject import detect  # noqa: E402
from buildproject.common import BuildError, error, fail, open_log, say  # noqa: E402

KINDS = ("xtool", "flutter", "dotnet", "rust", "expo", "reactnative", "bazel", "swiftpm") + detect.XCODE + detect.SHELLS


def build(d, kind, platform, device, release):
    # the recipes load only for a build (--detect / --describe stay quick)
    from buildproject import gen, native, pods, shells, xcode
    d = Path(os.path.realpath(d))
    if not d.is_dir():
        fail(f"{d} is not a directory")
    if kind is None:
        kind = detect.kind(d)
        if kind is None:
            detect.describe(d)  # its error names what a project needs
    if kind == "bazel":
        fail(f"{d}: {gen.bazel_blocker()}")
    if kind == "flutter":
        fail(f"{d}: Flutter apps build for real iPhones only (flutter/build.sh, flutter/ship.sh); simulator builds need an xtool project")
    if kind == "swiftpm":
        fail(f"{d}: a SwiftPM package without xtool.yml (add one: `version: 1` and `bundleID: com.you.App`)")
    if kind in ("expo", "reactnative"):
        if platform != "ios":
            fail(f"React Native and Expo apps build for iPhone and iPad devices here (not {platform})")
        return pods.build(d, kind, device, release)
    if kind in detect.SHELLS:
        return shells.build(d, kind, platform, device, release)
    if kind in detect.XCODE:
        # Cartfile: the dependencies first (carthage bootstrap); project.yml / Project.swift: the project
        gen.prepare(d, platform)
        return (xcode.device_build if device else xcode.build)(d, platform, release)
    if device:
        fail(f"{d}: build-project makes simulator builds of {kind} apps (device builds: device-run.sh, ship.sh)")
    return native.build(d, kind, platform, release)


def main():
    ap = argparse.ArgumentParser(prog="build-project", description="Build an app project on Linux (any kind this repo knows).")
    ap.add_argument("dirs", nargs="*", metavar="DIR")
    ap.add_argument("--detect", action="store_true", help="print the project's kind (nothing, exit 1: not a project)")
    ap.add_argument("--describe", action="store_true", help="one JSON line per DIR: dir, kind, name, bundle_id, app")
    ap.add_argument("--kind", choices=KINDS)
    ap.add_argument("--platform", default="ios", choices=("ios", "tvos", "watchos", "xros"))
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--simulator", action="store_true", help="a simulator build (the default)")
    g.add_argument("--device", action="store_true", help="an unsigned device build")
    ap.add_argument("--release", action="store_true")
    ap.add_argument("--log", metavar="FILE", help="also write the output to FILE")
    a = ap.parse_args()
    if a.describe:
        for d in a.dirs:
            try:
                print(json.dumps(detect.describe(d)))
            except (ValueError, OSError) as e:
                print(json.dumps({"dir": d, "error": str(e)}))
        return 0
    if len(a.dirs) != 1:
        ap.error("one project DIR")
    if a.detect:
        k = detect.kind(a.dirs[0])
        if k:
            print(k)
        return 0 if k else 1
    if a.log:
        open_log(a.log)
    try:
        app = build(a.dirs[0], a.kind, a.platform, a.device, a.release)
    except (BuildError, ValueError) as e:
        error(" ".join(str(e).split()))
        return 1
    say(f"app: {app}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
